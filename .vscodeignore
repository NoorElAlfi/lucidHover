# Packaged .vsix contents: only what's needed to run the extension at
# runtime (out/, sidecar/'s Python source, media/, and node_modules'
# production deps -- vsce already trims node_modules to production
# dependencies on its own). Everything else here is dev/test-only and was
# shipping by accident before this file existed (Build Order step 17's
# packaging dry-run measured 77.09 MB with no .vscodeignore at all -- the
# single largest contributor was `reference/` below, at 74.14 MB).

# TypeScript source -- only compiled out/ ships
src/**
tsconfig.json

# Compiled test output -- ships nothing under src/__tests__/, but tsc's
# own output layout mirrors src/ under out/, so the compiled tests land
# in out/ too and need their own exclusion.
out/extension/__tests__/**

# Dev/test-only content
.claude/**
.git/**
.gitignore
.mocharc.json
.pytest_cache/**
.vscode/**
.vscode-test/**
fixtures/**
reference/**
scripts/**
sidecar/tests/**
package-lock.json

# Docs meant for contributors, not extension users
CLAUDE.md
codebase-explainer-vscode-extension.md
lucidhover-current-state.md
lucidhover-session-briefs-*.md
lucidhover-ui-improvements.md
lucidhover-card-redesign.html
oddResponses.txt
workflow-review.md
docs/**

# Packaging output and generated reports -- never runtime content
dist/**

# better-sqlite3 ships prebuilt binaries per platform under prebuilds/
# (loaded directly by lib/binding.js) -- deps/ (vendored SQLite C
# amalgamation) and src/ (the native addon's C++ source) are only used
# to compile from source via node-gyp, which never happens at runtime
# since a matching prebuild always exists for our supported platforms.
node_modules/better-sqlite3/deps/**
node_modules/better-sqlite3/src/**

# @vscode/codicons ships far more than the panel webview needs at runtime
# (dist/codicon.css + dist/codicon.ttf, ~188 KB) -- codicon.html/codicon.svg/
# codicon.csv/codiconsLibrary.ts/metadata.json are dev-only reference
# material, ~4.7 MB.
node_modules/@vscode/codicons/dist/codicon.html
node_modules/@vscode/codicons/dist/codicon.svg
node_modules/@vscode/codicons/dist/codicon.csv
node_modules/@vscode/codicons/dist/codiconsLibrary.ts
node_modules/@vscode/codicons/dist/metadata.json

# Build/cache artifacts that can end up on disk locally
**/__pycache__/**
**/*.pyc
**/.pytest_cache/**
