{
  "javascript": {
    "displayName": "JavaScript",
    "vscodeLanguageId": "javascript",
    "extensions": [".js", ".jsx"],
    "treeSitter": {
      "grammarPackage": "tree_sitter_javascript",
      "grammarFunction": "language"
    },
    "tagQueryFile": "javascript_tags.scm",
    "exclusions": {
      "dirs": ["node_modules", "out", "dist", "build"],
      "defNames": ["constructor"],
      "refNames": ["require"],
      "caseSensitiveRefKinds": ["reference.jsx"]
    },
    "resolutionStrategy": "tree-sitter-only",
    "captureKindMap": {
      "definition.function": "function",
      "definition.method": "function",
      "reference.call": "call",
      "reference.jsx": "jsx"
    }
  },
  "typescript": {
    "displayName": "TypeScript",
    "vscodeLanguageId": "typescript",
    "extensions": [".ts"],
    "treeSitter": {
      "grammarPackage": "tree_sitter_typescript",
      "grammarFunction": "language_typescript"
    },
    "tagQueryFile": "typescript_tags.scm",
    "exclusions": {
      "dirs": ["node_modules", "out", "dist", "build"],
      "defNames": ["constructor"],
      "refNames": []
    },
    "resolutionStrategy": "tree-sitter-only",
    "captureKindMap": {
      "definition.function": "function",
      "definition.method": "function",
      "reference.call": "call"
    }
  },
  "typescriptreact": {
    "displayName": "TypeScript React",
    "vscodeLanguageId": "typescriptreact",
    "extensions": [".tsx"],
    "treeSitter": {
      "grammarPackage": "tree_sitter_typescript",
      "grammarFunction": "language_tsx"
    },
    "tagQueryFile": "typescript_tsx_tags.scm",
    "exclusions": {
      "dirs": ["node_modules", "out", "dist", "build"],
      "defNames": ["constructor"],
      "refNames": [],
      "caseSensitiveRefKinds": ["reference.jsx"]
    },
    "resolutionStrategy": "tree-sitter-only",
    "captureKindMap": {
      "definition.function": "function",
      "definition.method": "function",
      "reference.call": "call",
      "reference.jsx": "jsx"
    }
  },
  "python": {
    "displayName": "Python",
    "vscodeLanguageId": "python",
    "extensions": [".py"],
    "treeSitter": {
      "grammarPackage": "tree_sitter_python",
      "grammarFunction": "language"
    },
    "tagQueryFile": "python_tags.scm",
    "exclusions": {
      "dirs": ["__pycache__", ".venv", "venv", ".mypy_cache", ".pytest_cache", ".tox", "build", "dist"],
      "defNames": [],
      "refNames": []
    },
    "resolutionStrategy": "tree-sitter-only",
    "captureKindMap": {
      "definition.function": "function",
      "reference.call": "call"
    }
  }
}
